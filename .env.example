###############################################################################
# Environment Variables – Neuralis Intelligence Ecosystem
#
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` with real credentials.
###############################################################################

# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── AI / LLM ────────────────────────────────────────────────────────────────
VITE_GEMINI_API_KEY=your-gemini-api-key

# ── WhatsApp Business API ───────────────────────────────────────────────────
VITE_WHATSAPP_API_URL=https://graph.facebook.com/v21.0
VITE_WHATSAPP_API_TOKEN=your-whatsapp-api-token
VITE_WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
